[Unit]
Description=OxySync Telegram Bot + API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oxysync
WorkingDirectory=/opt/oxysync-bot
EnvironmentFile=/opt/oxysync-bot/.env
ExecStart=/opt/oxysync-bot/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
