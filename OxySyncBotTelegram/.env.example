# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Секрет сервера — случайная строка 64+ символов (никому не давать)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SERVER_SECRET=REPLACE_WITH_64_CHAR_HEX

# Мастер-ключ шифрования — случайная строка 64+ символов (никому не давать)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=REPLACE_WITH_64_CHAR_HEX

# Порт API сервера
API_PORT=8000

# Путь к базе данных
DB_PATH=oxysync.db

# Telegram ID администраторов (через запятую)
ADMIN_IDS=YOUR_TELEGRAM_ID
